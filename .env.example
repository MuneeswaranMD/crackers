# Crackers Shop Invoice Billing POS - Environment Variables
# Copy to .env.local for local development

# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shop Defaults
NEXT_PUBLIC_DEFAULT_SHOP_NAME="Sree Kalieswari Traders"
NEXT_PUBLIC_DEFAULT_CITY="Sivakasi"
NEXT_PUBLIC_DEFAULT_STATE="Tamil Nadu"
NEXT_PUBLIC_DEFAULT_GSTIN="33AABCS1429B1Z8"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# Application Mode (cloud | local_offline)
NEXT_PUBLIC_APP_MODE=cloud

# WooCommerce Store & REST API Integration
WOOCOMMERCE_STORE_URL=https://crackers.sreekalieswaritraders.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_signing_secret_here
